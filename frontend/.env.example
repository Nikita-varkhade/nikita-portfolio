# ==============================================================================
# Portfolio Email & API Configuration
# ==============================================================================

# Recipient Email for Contact Form Inquiries
RECIPIENT_EMAIL=shetenikita21@gmail.com

# ------------------------------------------------------------------------------
# Option A: Backend Express Server with Nodemailer (server.js)
# ------------------------------------------------------------------------------
# Gmail account used to send the emails (usually your Gmail)
EMAIL_USER=shetenikita21@gmail.com

# 16-character Gmail App Password (generate from Google Account > Security > 2-Step Verification > App Passwords)
# Leave space-free or quoted, e.g. "abcd efgh ijkl mnop"
EMAIL_PASS=your_16_digit_gmail_app_password
# (Alternative legacy variable name)
VITE_EMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Port for the Express server
PORT=3001

# Frontend API URL pointing to the backend server
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Option B: EmailJS Integration (for static hosting like GitHub Pages without server)
# ------------------------------------------------------------------------------
# Get these from https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
